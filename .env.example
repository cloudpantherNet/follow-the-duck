# Follow the Duck — configuration template.
# Copy to `.env` next to where you run `ftd` (or export as environment vars).
# NEVER commit the real .env — it holds your Cloudflare API token.

# --- Cloudflare Workers AI (required for live vision + speech) --------------
# Dashboard -> Workers AI. Create an API token with the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Models (verify availability in the Cloudflare docs if you change these)
#FTD_VISION_MODEL=@cf/cloudflare/clef-flash
#FTD_STT_MODEL=@cf/openai/whisper-large-v3-turbo
#FTD_STT_LANGUAGE=en

# --- Request budgets (keep cloud usage bounded and quotas predictable) ------
#FTD_MAX_VISION_CALLS_PER_MISSION=40
#FTD_MAX_VISION_CALLS_PER_MINUTE=30
#FTD_HTTP_TIMEOUT_S=20

# --- Camera -------------------------------------------------------------------
#FTD_CAMERA_BACKEND=auto          # auto | picamera2 | rpicam | mock
#FTD_CAMERA_WIDTH=640
#FTD_CAMERA_HEIGHT=480
#FTD_CAMERA_JPEG_QUALITY=85
#FTD_CAMERA_HFLIP=false           # set true/false after checking orientation
#FTD_CAMERA_VFLIP=false
#FTD_CAMERA_FOV_DEG=62            # horizontal field of view; calibrate

# --- Audio (inspect devices with `arecord -l` / `aplay -l`) --------------------
#FTD_MIC_DEVICE=default           # e.g. plughw:1,0 — NOT a hardcoded guess
#FTD_SPEAKER_DEVICE=default
#FTD_RECORD_SECONDS=4

# --- Hands-free mode (systemd: `ftd listen --hands-free`) --------------------
#FTD_HANDS_FREE_CHUNK_S=4         # length of each listening chunk
#FTD_VOICE_RMS_THRESHOLD=300      # local loudness gate; chunks quieter than
                                  # this are discarded with NO cloud call.
                                  # Calibrate with `ftd doctor --record`.

# --- On-device wake word (optional; needs: pip install -e '.[wakeword]') -----
# Fully local detection; audio goes to the cloud only AFTER the phrase fires.
# Pretrained openWakeWord phrases only (custom "hey duck" requires training):
# hey_jarvis_v0.1 ("hey jarvis"), alexa_v0.1, hey_mycroft_v0.1
#FTD_WAKE_WORD_ENABLED=false
#FTD_WAKE_WORD_MODEL=hey_jarvis_v0.1
#FTD_WAKE_WORD_THRESHOLD=0.5      # raise if it false-triggers, lower if deaf
#FTD_WAKE_WORD_COOLDOWN_S=2

# --- Motion (conservative defaults; tune only after physical calibration) ------
#FTD_DRIVE_SPEED=25               # SunFounder 0..100 power scale
#FTD_APPROACH_SPEED_NEAR=15
#FTD_MAX_SPEED=35                 # hard clamp
#FTD_PULSE_S=0.25                 # max single movement pulse
#FTD_MAX_STEER_DEG=20
#FTD_ALLOW_REVERSE=false          # keep false: no rear sensor coverage

# --- Safety thresholds -----------------------------------------------------------
#FTD_OBSTACLE_STOP_CM=20
#FTD_ARRIVAL_CM=30                # recalibrate on the robot (duck-height test!)
#FTD_HEARTBEAT_TIMEOUT_S=2
#FTD_GRAYSCALE_CLIFF_ENABLED=false  # enable ONLY after calibrating on your floor

# --- Search behavior ---------------------------------------------------------------
#FTD_SCAN_PAN_ANGLES_DEG=-35,0,35
#FTD_TILT_DEG=-10
#FTD_MISSION_TIME_BUDGET_S=90
#FTD_MAX_REPOSITION_STEPS=20

# --- Backends / misc -----------------------------------------------------------------
#FTD_HARDWARE_BACKEND=auto        # auto | picarx | mock
#FTD_RUNTIME_DIR=~/.ftd
